# Copy to .env.local for local dev. Real values live ONLY in Vercel env vars / .env.local (git-ignored).
# Never paste real values into chat.

# Supabase transaction pooler (port 6543), user format: role.projectref
DATABASE_URL_LOADER=postgresql://ctm_loader.<projectref>:<password>@<region>.pooler.supabase.com:6543/postgres
DATABASE_URL_READER=postgresql://ctm_reader.<projectref>:<password>@<region>.pooler.supabase.com:6543/postgres

# LLM (Phase 7)
OPENROUTER_API_KEY=
AGENT_MODEL=openai/gpt-4.1-mini
AGENT_FALLBACK_MODEL=google/gemini-2.5-flash
