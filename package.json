{
  "name": "ctm-usage-importer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "preview:data": "node scripts/build-preview.mjs",
    "db:up": "docker compose up -d --wait db",
    "db:test": "vitest run db/tests",
    "db:down": "docker compose down -v"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "postgres": "3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
